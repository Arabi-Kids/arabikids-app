 },
 "PO-2": {
  "ar": {
   "text": "الرُّكُوعُ ثُمَّ الرَّفْعُ وَالِاعْتِدَالُ."
  },
  "en": {
   "text": "Ruku', then rise up straight"
  },
  "ms": {
   "text": "Rukuk, kemudian bangun dan berdiri tegak"
  }
 },
 "PO-3": {
  "ar": {
   "text": "السُّجُودُ مَرَّتَيْنِ، وَبَيْنَهُمَا جُلُوسٌ."
  },
  "en": {
   "text": "Sujud twice, with a short sit between"
  },
  "ms": {
   "text": "Sujud dua kali, dengan duduk sebentar di antara kedua-duanya"
  }
 },
 "PO-4": {
  "ar": {
   "text": "تَتَكَرَّرُ الرَّكْعَةُ الثَّانِيَةُ؛ ثُمَّ نَجْلِسُ لِلتَّشَهُّدِ وَالصَّلَاةِ عَلَى النَّبِيِّ، ثُمَّ التَّسْلِيمُ فِي الصَّلَاةِ ذَاتِ الرَّكْعَتَيْنِ."
  },
  "en": {
   "text": "Rak'ah 2 repeats; sit for tashahhud, then tasleem in 2-rak'at prayers"
  },
  "ms": {
   "text": "Rakaat kedua diulang; duduk untuk tahiyat, kemudian salam dalam solat dua rakaat"
  }
 },
 "PO-5": {
  "ar": {
   "text": "فِي الصَّلَاةِ الثُّلَاثِيَّةِ وَالرُّبَاعِيَّةِ: نَجْلِسُ لِلتَّشَهُّدِ الْأَوَّلِ بَعْدَ الرَّكْعَةِ الثَّانِيَةِ ثُمَّ نُكْمِلُ، وَالتَّشَهُّدُ الْأَخِيرُ بَعْدَ آخِرِ رَكْعَةٍ."
  },
  "en": {
   "text": "3 and 4 rak'at prayers: sit for the first tashahhud after rak'ah 2, then continue; final tashahhud after the last rak'ah"
  },
  "ms": {
   "text": "Solat tiga dan empat rakaat: duduk tahiyat awal selepas rakaat kedua, kemudian teruskan; tahiyat akhir selepas rakaat terakhir"
  }
 }
}
