  }
 },
 "WD-L1": {
  "ar": {
   "title": "لِمَاذَا الْوُضُوءُ؟",
   "text": "قَبْلَ الصَّلَاةِ نُنَظِّفُ أَنْفُسَنَا بِالْمَاءِ. وَاللَّهُ يُحِبُّ الْمُحَافِظِينَ عَلَى النَّظَافَةِ."
  },
  "ms": {
   "title": "Mengapa wuduk?"
  }
 },
 "WD-L2": {
  "ar": {
   "title": "الْخُطُوَاتُ",
   "text": "اتَّبِعُوا الْخُطُوَاتِ بِالتَّرْتِيبِ."
  },
  "ms": {
   "title": "Langkah-langkah"
  }
 },
 "WD-L3": {
  "ar": {
   "title": "ثَلَاثَ مَرَّاتٍ وَالْيَمِينُ أَوَّلًا",
   "text": "نَغْسِلُ كُلَّ عُضْوٍ ثَلَاثَ مَرَّاتٍ، وَنَبْدَأُ بِالْجِهَةِ الْيُمْنَى."
  },
  "ms": {
   "title": "3 kali, kanan dahulu"
  }
 },
 "WD-L4": {
  "ar": {
   "title": "الدُّعَاءُ بَعْدَ الْوُضُوءِ",
   "text": "بَعْدَ الْوُضُوءِ نَقُولُ دُعَاءً خَاصًّا."
  },
  "ms": {
   "title": "Doa selepas wuduk"
  }
 },
 "WD-L5": {
  "ar": {
   "title": "مَا الَّذِي يُبْطِلُ الْوُضُوءَ؟",
   "text": "بَعْضُ الْأُمُورِ تُبْطِلُ الْوُضُوءَ، ثُمَّ نَتَوَضَّأُ مِنْ جَدِيدٍ."
  },
  "ms": {
   "title": "Apa yang membatalkan wuduk?"
  }
 },
 "WD-01": {
  "ar": {
   "title": "النِّيَّةُ وَالْبَسْمَلَةُ",
   "text": "انْوُوا فِي قُلُوبِكُمْ، ثُمَّ قُولُوا «بِسْمِ اللَّهِ»."
