# Frontend env (Vite only exposes VITE_-prefixed vars to the browser — never
# put a secret key here). Copy to frontend/.env and fill in.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push public key - must exactly match the root .env.example's
# VAPID_PUBLIC_KEY (see there for how to generate the pair).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Stripe Payment Links, one per package - created directly in the Stripe
# Dashboard (Payment Links -> create one per price). Each link must have its
# `tier` (standard/family) and `plan` (monthly/annual) set under that link's
# Advanced options -> Metadata, so netlify/functions/stripe-webhook.js can
# tell which package was purchased. Public URLs, safe in frontend env.
VITE_STRIPE_LINK_STANDARD_MONTHLY=https://buy.stripe.com/xxxxxxxxxxxx
VITE_STRIPE_LINK_STANDARD_ANNUAL=https://buy.stripe.com/xxxxxxxxxxxx
VITE_STRIPE_LINK_FAMILY_MONTHLY=https://buy.stripe.com/xxxxxxxxxxxx
VITE_STRIPE_LINK_FAMILY_ANNUAL=https://buy.stripe.com/xxxxxxxxxxxx
